# roles/openvox_gui/templates/nginx.conf.j2
# OpenVox GUI Nginx Reverse Proxy Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Upstream — где находится наше приложение
upstream openvox_gui_backend {
    # Несколько инстансов (для load balancing)
    server 127.0.0.1:{{ openvox_gui_port }};

    # Если есть ещё инстансы (в будущем):
    {% for backend_port in openvox_gui_backend_ports | default([]) %}
    server 127.0.0.1:{{ backend_port }};
    {% endfor %}
}

# HTTP сервер (перенаправить на HTTPS)
server {
    listen 80;
    listen [::]:80;

    server_name _;

    # Для Let's Encrypt验证
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Перенаправить всё остальное на HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS сервер (основной)
{% if openvox_gui_enable_ssl %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name _;

    # SSL сертификаты
    ssl_certificate {{ openvox_gui_ssl_cert_path }};
    ssl_certificate_key {{ openvox_gui_ssl_key_path }};

    # SSL настройки (modern/intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # HSTS (запомнить HTTPS на 1 год)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Логи
    access_log /var/log/nginx/openvox-gui_access.log;
    error_log /var/log/nginx/openvox-gui_error.log;

    # Главная локация
    location / {
        proxy_pass http://openvox_gui_backend;

        # Заголовки
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket поддержка
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Таймауты
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Буферизация
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # /health endpoint (без логирования)
    location = /health {
        proxy_pass http://openvox_gui_backend;
        access_log off;
    }

    # /metrics endpoint (для Prometheus)
    location = /metrics {
        proxy_pass http://openvox_gui_backend;
        access_log off;

        # Ограничить доступ (опционально)
        # allow 127.0.0.1;
        # deny all;
    }

    # Static assets (кэширование)
    location ~* ^/assets/ {
        proxy_pass http://openvox_gui_backend;

        # Кэшировать на 1 год (файлы версионированы)
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Лимит размера тела запроса (для файлов)
    client_max_body_size 100M;
}

{% else %}
# HTTP only (development)
server {
    listen 80;
    listen [::]:80;

    server_name _;

    access_log /var/log/nginx/openvox-gui_access.log;
    error_log /var/log/nginx/openvox-gui_error.log;

    location / {
        proxy_pass http://openvox_gui_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://openvox_gui_backend;
        access_log off;
    }
}
{% endif %}