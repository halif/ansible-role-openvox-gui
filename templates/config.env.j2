# roles/openvox_gui/templates/config.env.j2
# OpenVox GUI Configuration File
# Generated by Ansible - DO NOT EDIT MANUALLY
# Last updated: {{ ansible_date_time.iso8601 }}

# ==================== APPLICATION ====================
# Имя приложения
OPENVOX_GUI_APP_NAME="OpenVox GUI"

# Версия (read from VERSION file)
OPENVOX_GUI_VERSION="3.13.0-rc.25"

# ==================== NETWORK ====================
# На каком IP слушать (0.0.0.0 = все интерфейсы)
OPENVOX_GUI_HOST={{ openvox_gui_host }}

# На каком порту слушать
OPENVOX_GUI_PORT={{ openvox_gui_port }}

# Debug режим (ОПАСНО в production!)
OPENVOX_GUI_DEBUG={{ openvox_gui_debug | lower }}

# ==================== SSL/TLS ====================
# Включить HTTPS?
OPENVOX_GUI_ENABLE_SSL={{ openvox_gui_enable_ssl | lower }}

# Пути к SSL сертификатам
OPENVOX_GUI_SSL_CERT_PATH={{ openvox_gui_ssl_cert_path }}
OPENVOX_GUI_SSL_KEY_PATH={{ openvox_gui_ssl_key_path }}

# ==================== DATABASE ====================
# SQLite (по умолчанию)
DATABASE_URL={{ openvox_gui_database_url }}

# Для production с Postgres:
# DATABASE_URL=postgresql://user:password@localhost/openvox_gui

# ==================== PUPPET SERVICES ====================
# PuppetDB - источник истины о флоте
OPENVOX_GUI_PUPPETDB_HOST={{ openvox_gui_puppetdb_host }}
OPENVOX_GUI_PUPPETDB_PORT={{ openvox_gui_puppetdb_port }}

# PuppetServer - управление сертификатами и кодом
OPENVOX_GUI_PUPPET_SERVER_HOST={{ openvox_gui_puppet_server_host }}
OPENVOX_GUI_PUPPET_SERVER_PORT={{ openvox_gui_puppet_server_port }}

# ==================== AUTHENTICATION ====================
# Способ аутентификации: local, ldap, none
OPENVOX_GUI_AUTH_BACKEND={{ openvox_gui_auth_backend }}

# Для LDAP интеграции:
{% if openvox_gui_auth_backend == 'ldap' %}
OPENVOX_GUI_LDAP_SERVER={{ openvox_gui_ldap_server }}
OPENVOX_GUI_LDAP_PORT=389
OPENVOX_GUI_LDAP_USE_TLS=false
OPENVOX_GUI_LDAP_BASE_DN={{ openvox_gui_ldap_base_dn }}
OPENVOX_GUI_LDAP_BIND_DN=cn=admin,{{ openvox_gui_ldap_base_dn }}
# OPENVOX_GUI_LDAP_BIND_PASSWORD=your_password
{% endif %}

# ==================== SECURITY ====================
# Secret key для подписи JWT токенов
# ⚠️  ВАЖНО: Сгенерируй это вручную, не коммитьте в git!
{% if openvox_gui_secret_key is defined %}
OPENVOX_GUI_SECRET_KEY={{ openvox_gui_secret_key }}
{% else %}
# SECRET_KEY not set - generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENVOX_GUI_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
{% endif %}

# ==================== PATHS ====================
# Где хранить данные (БД, preferences, backups)
OPENVOX_GUI_DATA_DIR={{ openvox_gui_data_dir }}

# Где писать логи
OPENVOX_GUI_LOG_DIR={{ openvox_gui_log_dir }}

# Где установлена роль
OPENVOX_GUI_HOME={{ openvox_gui_home }}

# ==================== PERFORMANCE ====================
# Сколько uvicorn воркеров запустить
OPENVOX_GUI_WORKERS={{ openvox_gui_workers | default(4) }}

# ==================== FEATURES ====================
# Включить экспериментальные фичи?
OPENVOX_GUI_EXPERIMENTAL_FEATURES=false

# Локально разработчикам:
# export OPENVOX_GUI_DEBUG=true
# export OPENVOX_GUI_PUPPETDB_HOST=localhost
# export OPENVOX_GUI_PUPPET_SERVER_HOST=localhost
# python -m uvicorn app.main:app --reload