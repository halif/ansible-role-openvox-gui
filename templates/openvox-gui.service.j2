# roles/openvox_gui/templates/openvox-gui.service.j2
# OpenVox GUI Systemd Service Unit
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=OpenVox GUI - Puppet Infrastructure Management Console
Documentation=https://github.com/cvquesty/openvox-gui
After=network-online.target
Wants=network-online.target

# Зависит ли от других сервисов?
{% if openvox_gui_puppetdb_host == '127.0.0.1' or openvox_gui_puppetdb_host == 'localhost' %}
# Если PuppetDB на этой же машине:
After=puppetdb.service
{% endif %}

[Service]
# Тип сервиса
Type=notify
Restart=on-failure
RestartSec=10

# Под каким пользователем запускать
User={{ openvox_gui_user }}
Group={{ openvox_gui_group }}

# Рабочая директория
WorkingDirectory={{ openvox_gui_home }}

# Как запускать сервис
ExecStart={{ openvox_gui_venv_path }}/bin/python -m uvicorn \
    app.main:app \
    --host {{ openvox_gui_host }} \
    --port {{ openvox_gui_port }} \
    --workers {{ openvox_gui_workers | default(4) }} \
    --log-level info \
    --access-log

# Переменные окружения
EnvironmentFile={{ openvox_gui_home }}/config/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

# Graceful shutdown (подождать 30 сек перед kill -9)
KillMode=mixed
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ openvox_gui_data_dir }} {{ openvox_gui_log_dir }}

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openvox-gui

# Лимиты ресурсов (защита от DoS)
LimitNOFILE=65535
LimitNPROC=32768

[Install]
# Автозапуск при загрузке системы
WantedBy=multi-user.target