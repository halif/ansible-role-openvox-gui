# OpenVox GUI Systemd Service Unit
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=OpenVox GUI - Puppet Infrastructure Management Console
Documentation=https://github.com/cvquesty/openvox-gui
After=network-online.target
Wants=network-online.target

{% if openvox_gui_puppetdb_host == '127.0.0.1' or openvox_gui_puppetdb_host == 'localhost' %}
After=puppetdb.service
{% endif %}

[Service]
Type=notify
Restart=on-failure
RestartSec=10

User={{ openvox_gui_user }}
Group={{ openvox_gui_group }}

WorkingDirectory={{ openvox_gui_home }}

ExecStart={{ openvox_gui_venv_path }}/bin/python -m uvicorn \\
    app.main:app \\
    --host {{ openvox_gui_host }} \\
    --port {{ openvox_gui_port }} \\
    --workers {{ openvox_gui_workers | default(4) }} \\
    --log-level info \\
    --access-log

EnvironmentFile={{ openvox_gui_home }}/config/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ openvox_gui_data_dir }} {{ openvox_gui_log_dir }}

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openvox-gui

LimitNOFILE=65535
LimitNPROC=32768

[Install]
WantedBy=multi-user.target
